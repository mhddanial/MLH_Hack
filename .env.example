# Copy this file to .env.local (or .env) and fill in your credentials.
# On Vercel, add these under Project Settings -> Environment Variables.
# NEVER commit .env or .env.local to git!

# --- AI Layer (Google Gemini API / Gemma 4) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMMA_MODEL_ID=gemma-4-26b-a4b-it
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
AI_MODE=auto
AI_TIMEOUT_S=90
CONFIDENCE_THRESHOLD=0.60
MAX_IMAGE_SIDE=1600

# --- Database Layer (Supabase PostgreSQL + Local Fallback) ---
NEXT_PUBLIC_SUPABASE_URL=https://rrkafcbuhnnwnduvwluq.supabase.co
SUPABASE_URL=https://rrkafcbuhnnwnduvwluq.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here
SUPABASE_TABLE=aoi_inspections
